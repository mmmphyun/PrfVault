#!/bin/sh
# PrfVault Pre-commit Secret Scanner
# Git Staged Area에 포함된 민감 정보(개인키, API 토큰, 엔트로피 비정상 문자열) 차단

# 1. gitleaks 바이너리 확인
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "[WARNING] 'gitleaks' 바이너리가 시스템 PATH에 없습니다."
    echo "[WARNING] 로컬 시크릿 스캔이 생략됩니다. 다음 명령으로 설치를 권장합니다:"
    echo "[WARNING]   Windows (PowerShell): winget install Gitleaks.Gitleaks"
    echo "[WARNING] 원격 GitHub Actions CI 단계에서 서버 사이드 검사가 강제됩니다."
    exit 0
fi

# 2. Staged 변경사항에 대해 시크릿 스캔 수행
# -v: 상세 출력
# --staged: git index(staged) 상태만 검사
# --config: 프로젝트 루트의 .gitleaks.toml 적용
gitleaks protect --staged -v --config=.gitleaks.toml
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "===================================================================="
    echo "[SECURITY BLOCK] 커밋 대상 파일에서 하드코딩된 시크릿이 감지되었습니다."
    echo "1. 실제 비밀키/토큰인 경우 코드를 수정하여 환경변수로 격리하십시오."
    echo "2. 테스트 벡터/모의 키인 경우 .gitleaks.toml의 allowlist에 등록하십시오."
    echo "===================================================================="
    echo ""
    exit $EXIT_CODE
fi

exit 0
